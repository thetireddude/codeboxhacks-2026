# Complete environment-variable catalog. Copy process-specific templates instead
# of using this file directly. Blank values are optional in Milestone 0.

# Frontend (public; never place secrets in VITE_* variables)
VITE_BACKEND_URL=http://localhost:5000

# Backend application
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000
SECRET_KEY=local-development-only
CORS_ORIGINS=http://localhost:5173

# Configurable gameplay rules (declared now, consumed in later milestones)
ROUND_DURATION_MS=60000
STARTING_SWITCH_COUNT=5
TURN_END_SILENCE_MS=900
SWITCH_MODE=ALWAYS_AVAILABLE_DURING_OPPONENT_TURN
CHAIN_SWITCH_WINDOW_MS=500

# Redis is required for Multiplayer Foundation (B1).
REDIS_URL=redis://localhost:6379/0
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_API_KEY=
GEMINI_SCENARIO_MODEL=gemini-3.1-flash-lite
GEMINI_SCENARIO_MAX_ATTEMPTS=2
STT_PROVIDER=
STT_API_KEY=
