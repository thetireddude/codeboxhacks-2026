FLASK_ENV=development
# On a remote backend host, set HOST=0.0.0.0 and allow only the deployed
# frontend origin in CORS_ORIGINS. The browser never needs the keys below.
HOST=127.0.0.1
PORT=5000
SECRET_KEY=local-development-only
CORS_ORIGINS=http://localhost:5173

# Configurable gameplay rules for later milestones
ROUND_DURATION_MS=60000
COUNTDOWN_DURATION_MS=3000
MATCH_CLEANUP_DELAY_MS=300000
STARTING_SWITCH_COUNT=5
TURN_END_SILENCE_MS=900
SWITCH_RESPONSE_MIN_MS=0
SWITCH_MODE=ALWAYS_AVAILABLE_DURING_OPPONENT_TURN
CHAIN_SWITCH_WINDOW_MS=500

# Redis is required for Multiplayer Foundation (B1).
REDIS_URL=redis://localhost:6379/0
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=3600
GEMINI_API_KEY=
GEMINI_SCENARIO_MODEL=gemini-3.1-flash-lite
GEMINI_SCENARIO_MAX_ATTEMPTS=2
GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite
GEMINI_JUDGE_MAX_ATTEMPTS=2
GEMINI_JUDGE_TIMEOUT_MS=12000

# Deterministic A6 Switch-recovery Speed curve.
SPEED_BASE_POINTS=500
SPEED_DECAY_POINTS_PER_SECOND=120
SPEED_MAX_POINTS=2000

# Realtime speech-to-text (A2). Keep this key on the backend only.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=flux-general-en
STT_SAMPLE_RATE=16000
STT_CHUNK_MS=80
