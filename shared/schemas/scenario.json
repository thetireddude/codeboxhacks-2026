{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://improv-faceoff.local/schemas/scenario.json",
  "title": "Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["tone", "scenario", "player_a_role", "player_b_role"],
  "properties": {
    "tone": {
      "type": "string",
      "enum": ["mundane", "relatable", "funny", "serious", "sad", "awkward", "tense", "wholesome", "emotional", "suspenseful", "dramatic"]
    },
    "scenario": { "type": "string", "minLength": 1 },
    "player_a_role": { "type": "string", "minLength": 1 },
    "player_b_role": { "type": "string", "minLength": 1 }
  }
}
